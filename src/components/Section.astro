---
import type { Theme } from '../data/content';

interface Props {
  id: string;
  theme: Theme;
  label: string;
  active?: boolean;
  reveal?: 'default' | 'subtle';
}

const { id, theme, label, active = false, reveal = 'default' } = Astro.props;
---

<section class:list={['section', { 'is-active': active }]} id={id} data-section data-theme={theme} data-reveal-style={reveal} aria-label={label}>
  <div class="section__inner">
    <div class="section__tilt" data-tilt>
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: var(--bg);
    color: var(--fg);
  }

  .section__inner {
    position: relative;
    height: 100%;
    min-height: 100svh;
  }

  .section__tilt {
    height: 100%;
  }

  @media (min-width: 1100px) {
    .section__inner {
      perspective: 1800px;
    }

    .section__tilt {
      transform-origin: 50% 50%;
      will-change: transform;
    }
  }

  :global(.js) .section {
    position: fixed;
    inset: 0;
    min-height: 0;
    visibility: hidden;
    box-shadow: 0 0 80px rgb(17 47 65 / 0.25);
  }

  :global(.js) .section.is-active {
    visibility: visible;
  }

  :global(.js) .section__inner {
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }

  :global(.js) .section__inner::-webkit-scrollbar {
    display: none;
  }
</style>
