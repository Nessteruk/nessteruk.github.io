---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'span'> & {
  href?: string;
  size?: 'md' | 'lg';
};

const { href, size = 'md', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['highlight', `highlight--${size}`, className]} href={href} {...rest}><slot /></Tag>

<style>
  .highlight {
    display: inline-block;
    padding: 0 8px 2px;
    font-size: 18px;
    line-height: 24px;
    white-space: nowrap;
    color: var(--color-tertiary);
    background: linear-gradient(var(--color-main), var(--color-main)) left bottom / calc(var(--hl, 1) * 100%) 12px
      no-repeat;
  }

  .highlight--lg {
    font-size: clamp(18px, 5.6vw, 22px);
    line-height: 1.3;
    background-size: calc(var(--hl, 1) * 100%) 0.6em;
  }

  a.highlight {
    transition: background-size 0.4s cubic-bezier(0.65, 0, 0.35, 1);
  }

  a.highlight:hover {
    background-size: 100% 100%;
  }

  @media (min-width: 1100px) {
    .highlight {
      padding: 0 calc(8 * var(--u)) calc(7 * var(--u));
      font-size: calc(40 * var(--u));
      line-height: 1.21;
      background-size: calc(var(--hl, 1) * 100%) calc(28 * var(--u));
    }
  }
</style>
