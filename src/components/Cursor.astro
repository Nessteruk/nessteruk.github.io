<div class="cursor" data-cursor data-state="default" data-theme="light" data-follow-theme aria-hidden="true">
  <span class="cursor__ring"></span>
  <span class="cursor__dot"></span>
  <span class="cursor__text"></span>
</div>

<style>
  .cursor {
    display: none;
  }

  :global(.has-cursor) .cursor {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    display: block;
    width: 0;
    height: 0;
    color: var(--cursor-mix);
    pointer-events: none;
    mix-blend-mode: difference;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  :global(.has-cursor) .cursor.is-visible {
    opacity: 1;
  }

  .cursor__ring,
  .cursor__dot,
  .cursor__text {
    position: absolute;
    top: 0;
    left: 0;
    translate: -50% -50%;
    transition:
      width 0.35s cubic-bezier(0.65, 0, 0.35, 1),
      height 0.35s cubic-bezier(0.65, 0, 0.35, 1),
      opacity 0.2s ease,
      scale 0.3s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .cursor__ring {
    width: 32px;
    height: 32px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  .cursor__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .cursor__text {
    width: 11px;
    height: 32px;
    opacity: 0;
    scale: 1 0.5;
    background:
      linear-gradient(currentColor, currentColor) center / 1px 100% no-repeat,
      linear-gradient(currentColor, currentColor) top / 100% 1px no-repeat,
      linear-gradient(currentColor, currentColor) bottom / 100% 1px no-repeat;
  }

  .cursor[data-state='hover'] .cursor__ring {
    width: 20px;
    height: 20px;
  }

  .cursor[data-state='text'] .cursor__ring,
  .cursor[data-state='text'] .cursor__dot {
    opacity: 0;
    scale: 0.4;
  }

  .cursor[data-state='text'] .cursor__text {
    opacity: 1;
    scale: 1;
  }
</style>
