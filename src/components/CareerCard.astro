---
interface Props {
  title: string;
  desc: string;
}

const { title, desc } = Astro.props;
---

<li class="career-card" data-reveal="1">
  <h3 class="career-card__title">{title}</h3>
  <p class="career-card__desc">{desc}</p>
</li>

<style>
  .career-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    text-align: center;
    color: var(--color-tertiary);
  }

  .career-card__title {
    font-size: 19px;
    font-weight: 700;
    line-height: 26px;
  }

  .career-card__desc {
    font-size: 16px;
    line-height: 28px;
  }

  @media (min-width: 1100px) {
    .career-card {
      gap: 0;
      width: calc(791 * var(--u));
    }

    .career-card__title {
      font-size: calc(32 * var(--u));
      line-height: 1.21;
    }

    .career-card__desc {
      font-size: max(15px, calc(20 * var(--u)));
      line-height: max(24px, calc(32 * var(--u)));
    }
  }
</style>
