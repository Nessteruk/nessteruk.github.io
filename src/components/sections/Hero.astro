---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import HighlightText from '../HighlightText.astro';
import illustration from '../../assets/illustration.png';
import { roles } from '../../data/content';

const lead = 'Hey ! I’m a';
---

<Section id="home" theme="light" label="Introduction" active reveal="subtle">
  <div class="hero">
    <div class="hero__picture" data-reveal="3">
      <Image src={illustration} alt="Illustrated portrait of Lucas Bonnard" widths={[460, 919]} sizes="43vw" loading="eager" style="--tilt-depth: 0.4" data-tilt-depth />
    </div>
    <div class="hero__text">
      <p class="hero__intro" data-intro data-roles={JSON.stringify(roles)}>
        <span class="visually-hidden">{lead} {roles[0]}</span>
        <span class="hero__intro-line" aria-hidden="true">
          <span data-intro-lead data-text={lead}>{lead}</span>
          <HighlightText size="lg" data-intro-highlight><span data-intro-role>{roles[0]}</span></HighlightText>
        </span>
      </p>
      <h1 class="hero__name" data-reveal="1"><span>Lucas</span> <span>Bonnard</span></h1>
      <p class="hero__desc" data-reveal="1">
        Based in Paris, I have 5 years of experience in the video game industry and 2 years in product design.
      </p>
    </div>
  </div>
</Section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    padding: calc(var(--header-height) + 40px) var(--gutter) 40px;
  }

  .hero__picture {
    display: none;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: 354px;
    text-align: center;
  }

  .hero__intro {
    font-size: clamp(18px, 5.6vw, 22px);
    line-height: 1.3;
    white-space: nowrap;
  }

  .hero__intro-line {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.28em;
  }

  .hero__intro-line :global(.highlight) {
    padding-inline: 0.12em;
    margin-inline: -0.12em;
  }

  [data-intro-role] {
    position: relative;
  }

  [data-intro-role] :global(.caret) {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.12em + 3px);
    margin-left: 0;
    translate: 0 -50%;
  }

  .hero__name {
    font-size: clamp(48px, 17vw, 72px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -1.5px;
    text-transform: uppercase;
  }

  .hero__desc {
    padding-inline: 8px;
  }

  .hero__name span {
    display: block;
  }

  .hero__desc {
    font-size: 16px;
    line-height: 28px;
  }

  @media (min-width: 1100px) {
    .hero {
      align-items: center;
      height: 100%;
      padding: var(--header-height) 0 0;
      overflow: hidden;
    }

    .hero__picture {
      position: absolute;
      right: calc(-164 * var(--u));
      bottom: calc(-165 * var(--u));
      display: block;
      width: calc(818 * var(--u));
      height: calc(1136 * var(--u));
    }

    .hero__picture img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .hero__text {
      position: relative;
      max-width: none;
      padding: 0;
      gap: calc(40 * var(--u));
    }

    .hero__intro {
      font-size: calc(40 * var(--u));
      line-height: 1.21;
    }



    .hero__name {
      font-size: calc(200 * var(--u));
      line-height: 0.92;
      letter-spacing: 0;
    }

    .hero__desc {
      width: calc(432 * var(--u));
      font-size: max(15px, calc(20 * var(--u)));
      line-height: max(24px, calc(32 * var(--u)));
      text-align: left;
    }
  }
</style>
