---
import { Image } from 'astro:assets';
import Section from '../Section.astro';
import HighlightText from '../HighlightText.astro';
import Button from '../Button.astro';
import illustration from '../../assets/illustration.png';
import { links } from '../../data/content';
---

<Section id="contact" theme="light" label="Contact">
  <div class="contact">
    <div class="contact__picture" data-reveal="3">
      <Image src={illustration} alt="" widths={[460, 919]} sizes="43vw" />
    </div>
    <div class="contact__content">
      <h2 class="contact__title" data-reveal="1">Contact me</h2>
      <div data-reveal="1">
        <HighlightText href={`mailto:${links.email}`} size="lg">{links.email}</HighlightText>
      </div>
      <div class="contact__buttons">
        <div data-reveal="1"><Button href={links.behance} external>Behance</Button></div>
        <div data-reveal="1"><Button href={links.linkedin} external>LinkedIn</Button></div>
      </div>
    </div>
  </div>
</Section>

<style>
  .contact {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    padding: calc(var(--header-height) + 40px) var(--gutter) 40px;
  }

  .contact__picture {
    display: none;
  }

  .contact__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .contact__title {
    font-size: clamp(36px, 12vw, 48px);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .contact__buttons {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding-top: 80px;
  }

  @media (min-width: 1100px) {
    .contact {
      height: 100%;
      padding: calc(80 * var(--u)) 0 0;
    }

    .contact__picture {
      position: absolute;
      right: calc(-164 * var(--u));
      bottom: calc(-153 * var(--u));
      display: block;
      width: calc(818 * var(--u));
      height: calc(1136 * var(--u));
    }

    .contact__picture img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }

    .contact__content {
      gap: calc(32 * var(--u));
      width: auto;
    }

    .contact__title {
      font-size: calc(100 * var(--u));
      line-height: 1.21;
    }

    .contact__buttons {
      gap: calc(20 * var(--u));
      padding-top: calc(80 * var(--u));
    }
  }
</style>
