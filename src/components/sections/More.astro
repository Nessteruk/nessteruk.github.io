---
import Section from '../Section.astro';
import SpeechText from '../SpeechText.astro';
import TextCard from '../TextCard.astro';
import { moreSkills } from '../../data/content';
---

<Section id="more" theme="accent" label="More skills">
  <div class="section-stack">
    <SpeechText text="And there is more." />
    <div class="more">
      {moreSkills.map((skill) => <TextCard {...skill} />)}
    </div>
  </div>
</Section>

<style>
  .more {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: 100%;
    max-width: 482px;
    padding-inline: 40px;
  }

  @media (min-width: 1100px) {
    .more {
      display: grid;
      grid-template-columns: repeat(2, max-content);
      gap: calc(80 * var(--u));
      width: auto;
      max-width: none;
      padding: 0;
    }
  }
</style>
