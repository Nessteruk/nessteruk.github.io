---
import Section from '../Section.astro';
import SpeechText from '../SpeechText.astro';
import TextCard from '../TextCard.astro';
import { skills } from '../../data/content';
---

<Section id="skills" theme="accent" label="Skills">
  <div class="section-stack">
    <SpeechText text="What can I bring to you ?" />
    <div class="skills">
      {skills.map((skill, i) => <TextCard {...skill} number={String(i + 1).padStart(2, '0')} />)}
    </div>
  </div>
</Section>

<style>
  .skills {
    display: flex;
    flex-direction: column;
    gap: 36px;
    width: 100%;
    max-width: 482px;
    padding-inline: 40px;
  }

  @media (min-width: 1100px) {
    .skills {
      flex-direction: row;
      justify-content: center;
      gap: calc(80 * var(--u));
      width: auto;
      max-width: none;
      padding: 0;
    }
  }
</style>
