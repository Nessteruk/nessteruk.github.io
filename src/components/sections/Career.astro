---
import Section from '../Section.astro';
import SpeechText from '../SpeechText.astro';
import CareerCard from '../CareerCard.astro';
import { career } from '../../data/content';
---

<Section id="career" theme="accent" label="Career">
  <div class="section-stack">
    <SpeechText text="Have a look at my professional journey." />
    <ol class="career">
      {career.map((item) => <CareerCard {...item} />)}
    </ol>
  </div>
</Section>

<style>
  .career {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    width: 100%;
    max-width: 402px;
    padding-inline: 30px;
  }

  @media (min-width: 1100px) {
    .career {
      gap: calc(40 * var(--u));
      width: auto;
      max-width: none;
      padding: 0;
    }
  }
</style>
